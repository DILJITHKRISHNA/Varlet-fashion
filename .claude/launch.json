{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "varlet-expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Varlet-app", "run", "web"],
      "port": 8081
    },
    {
      "name": "varlet-fashion-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Varlet-fashion/frontend", "run", "dev"],
      "port": 8082,
      "autoPort": true
    },
    {
      "name": "varlet-api",
      "runtimeExecutable": "Varlet-fashion/backend/.venv/bin/python",
      "runtimeArgs": [
        "-m", "uvicorn", "app.main:app",
        "--app-dir", "Varlet-fashion/backend",
        "--host", "0.0.0.0", "--port", "8100",
        "--reload", "--reload-dir", "Varlet-fashion/backend/app"
      ],
      "port": 8100
    }
  ]
}
