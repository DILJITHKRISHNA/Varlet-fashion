# Copy to .env.local and fill in — run `npx supabase status` to get local values.
# Leave the URL as the 127.0.0.1 loopback below for ALL platforms (web, iOS
# Simulator, Android emulator, physical device via Expo Go). src/services/supabase.ts
# auto-rewrites it to the LAN IP the device is already using to reach Metro,
# so you never need to hand-edit this per platform. Only point it at a real
# https://xxxx.supabase.co URL once you have a hosted project.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
