# Copy to .env (never commit .env).  `python -m app.setup_env` writes one for local development.

ENVIRONMENT=development

# Local Postgres from `npx supabase start` (run inside Varlet-app), or your hosted
# connection string (Supabase: Project settings > Database > Session pooler).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# At least 32 random characters. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# Image search. Free key from Google AI Studio; leave empty to switch the feature off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Password given to the demo accounts by `python -m app.seed` (local use only).
SEED_PASSWORD=
